# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# From Supabase project settings -> Database -> Connection string (URI, "Transaction" pooler)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.pooler.supabase.com:6543/postgres

# From console.anthropic.com -> API Keys
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model used for natural-language search parsing and summaries.
# Check https://docs.claude.com for the current recommended small/fast model
# if this string is no longer valid by the time you're building.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
